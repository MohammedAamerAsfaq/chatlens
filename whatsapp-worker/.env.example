# ChatLens WhatsApp Worker - Environment Configuration
# Copy to .env and fill in your values.

PORT=3001
DJANGO_BASE_URL=http://localhost:8000
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_STORE_PATH=./sessions
LOG_LEVEL=info
INGESTION_BUFFER_PATH=./ingestion-buffer/ingestion.sqlite
INGESTION_DISPATCH_INTERVAL_MS=1000
# Set false when `npm run start:dispatcher` is installed as its own service.
INGESTION_DISPATCHER_ENABLED=true

# Optional: set this when the worker cannot fetch the latest Baileys WhatsApp
# Web version from GitHub/raw. Format: major,minor,patch
# WHATSAPP_WEB_VERSION=2,3000,1035194821
